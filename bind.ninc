; ********************************* calling & DLLs ******************************** ;

_lla:
    ds_overflow 1
    mov r8, LoadLibraryA
    stack_pushq r8, DATA_TOS_REG
    jmp _next

_gpa:
    ds_overflow 1
    mov r8, GetProcAddress
    stack_pushq r8, DATA_TOS_REG
    jmp _next

_rt_call:
    mov r11, [IP_REG]
    call r11 ; `bind` has done all the work of loading the registers. God help us all.
    add IP_REG, POINTER_SIZE ; step over the data cell
    jmp _next

; bind signature can be represented by: [vqdufF](;|[ifF]*)?
; A return code is mandatory; the optional |-suffix lists argument codes, one per
; argument, in call order.
; _______________________________________________________________________________________
; | Code | Meaning                                                     | Valid position |
; |------|-------------------------------------------------------------|----------------|
; |  v   | void. No return value. Push nothing.                        | return only    |
; |  q   | qword. Full 64 bits of rax. Pushed.                         | return only    |
; |  d   | dword. eax, sign-extended to a cell. Pushed.                | return only    |
; |  u   | dword. eax, zero-extended to a cell. Pushed.                | return only    |
; |  i   | integer or pointer, any width. Whole cell moved to          | argument only  |
; |      | parameter register; callee handles the upper bits.          |                |
; |  f   | 32-bit float. Returned in xmm0, passed in xmmN. Pushed.     | return/arg     |
; |  F   | 64-bit float. Returned in xmm0, passed in xmmN. Pushed.     | return/arg     |
; |______|_____________________________________________________________|________________|


; `bind` creates a word that marshals the arguments according to the signature string.
; Decisions that need to be made:
;   * Whether 'B' is present in the signature. If it is, then the register mapping is bumped by 1.
;   * The size of the shadow space. For every other argument past 4 (or 3?), more shadow space must be reserved in
;     16-byte chunks, I think...
;
; ( callee_addr sig_addr -- <name that follows `bind` on the input is a word that marshals according to sig_addr> )


_arg1u:
    stack_popq r10, DATA_TOS_REG ; value
    mov ecx, r10d
    jmp _next

_arg1i:
    stack_popq rcx, DATA_TOS_REG
    jmp _next

_arg1q:
    stack_popq rcx, DATA_TOS_REG
    jmp _next

_arg1d:
    stack_popq r10, DATA_TOS_REG
    movsxd rcx, r10d
    jmp _next

_arg1f:
    stack_popq r11, DATA_TOS_REG
    movd xmm0, r11d
    jmp _next

_arg1F:
    stack_popq r10, DATA_TOS_REG
    movq xmm0, r10
    jmp _next

_arg2u:
    stack_popq r10, DATA_TOS_REG ; value
    mov edx, r10d
    jmp _next

_arg2i:
    stack_popq r10, DATA_TOS_REG
    mov rdx, r10
    jmp _next

_arg2q:
    stack_popq rdx, DATA_TOS_REG
    jmp _next

_arg2d:
    stack_popq r10, DATA_TOS_REG
    movsxd rdx, r10d
    jmp _next

_arg2f:
    stack_popq r11, DATA_TOS_REG
    movd xmm1, r11d
    jmp _next

_arg2F:
    stack_popq r10, DATA_TOS_REG
    movq xmm1, r10
    jmp _next

_arg3u:
    stack_popq r10, DATA_TOS_REG ; value
    mov r8d, r10d
    jmp _next

_arg3i:
    stack_popq r10, DATA_TOS_REG
    mov r8, r10
    jmp _next

_arg3q:
    stack_popq r8, DATA_TOS_REG
    jmp _next

_arg3d:
    stack_popq r10, DATA_TOS_REG
    movsxd r8, r10d
    jmp _next

_arg3f:
    stack_popq r11, DATA_TOS_REG
    movd xmm2, r11d
    jmp _next

_arg3F:
    stack_popq r10, DATA_TOS_REG
    movq xmm2, r10
    jmp _next

_arg4u:
    stack_popq r10, DATA_TOS_REG ; value
    mov r9d, r10d
    jmp _next

_arg4i:
    stack_popq r10, DATA_TOS_REG
    mov r9, r10
    jmp _next

_arg4q:
    stack_popq r9, DATA_TOS_REG
    jmp _next

_arg4d:
    stack_popq r10, DATA_TOS_REG
    movsxd r9, r10d
    jmp _next

_arg4f:
    stack_popq r11, DATA_TOS_REG
    movd xmm3, r11d
    jmp _next

_arg4F:
    stack_popq r10, DATA_TOS_REG
    movq xmm3, r10
    jmp _next

bind_arg1:
    ; r10b contains the type specifier
    mov rdi, [rel here]
    cmp r10b, 'q'
    jne .check_d
    lea rax, [rel cfa_arg1q]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_d:
    cmp r10b, 'd'
    jne .check_i
    lea rax, [rel cfa_arg1q]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_i:
    cmp r10b, 'i'
    jne .check_f
    lea rax, [rel cfa_arg1i]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_f:
    cmp r10b, 'f'
    jne .do_F
    lea rax, [rel cfa_arg1f]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .do_F: ; no check. `bind` sets this up, so it's already checked.
    lea rax, [rel cfa_arg1F]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret

bind_arg2:
    ; r10b contains the type specifier
    mov rdi, [rel here]
    cmp r10b, 'q'
    jne .check_d
    lea rax, [rel cfa_arg2q]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_d:
    cmp r10b, 'd'
    jne .check_i
    lea rax, [rel cfa_arg2d]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_i:
    cmp r10b, 'i'
    jne .do_ui
    .check_u:
    cmp r10b, 'u'
    jne .check_f
    .do_ui:
    lea rax, [rel cfa_arg2u]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_f:
    cmp r10b, 'f'
    jne .do_F
    lea rax, [rel cfa_arg2f]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .do_F: ; no check. `bind` sets this up, so it's already checked.
    lea rax, [rel cfa_arg2F]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret

bind_arg3:
    ; r10b contains the type specifier
    mov rdi, [rel here]
    cmp r10b, 'q'
    jne .check_d
    lea rax, [rel cfa_arg3q]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_d:
    cmp r10b, 'd'
    jne .check_i
    lea rax, [rel cfa_arg3d]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_i:
    cmp r10b, 'i'
    jne .do_ui
    .check_u:
    cmp r10b, 'u'
    jne .check_f
    .do_ui:
    lea rax, [rel cfa_arg3u]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_f:
    cmp r10b, 'f'
    jne .do_F
    lea rax, [rel cfa_arg3f]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .do_F: ; no check. `bind` sets this up, so it's already checked.
    lea rax, [rel cfa_arg3F]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret

bind_arg4:
    ; r10b contains the type specifier
    mov rdi, [rel here]
    cmp r10b, 'q'
    jne .check_d
    lea rax, [rel cfa_arg4q]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_d:
    cmp r10b, 'd'
    jne .check_i
    lea rax, [rel cfa_arg4d]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_i:
    cmp r10b, 'i'
    jne .do_ui
    .check_u:
    cmp r10b, 'u'
    jne .check_f
    .do_ui:
    lea rax, [rel cfa_arg4u]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_f:
    cmp r10b, 'f'
    jne .do_F
    lea rax, [rel cfa_arg4f]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .do_F: ; no check. `bind` sets this up, so it's already checked.
    lea rax, [rel cfa_arg4F]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret

_movrsp:
    ; get the current instruction pointer
    mov r8, [IP_REG]
    sub rsp, [IP_REG]
    add IP_REG, POINTER_SIZE
    jmp _next

_rsp:
    ds_overflow 1
    stack_pushq rsp, DATA_TOS_REG
    jmp _next

; ( n -- <stack loading tokens placed in reverse order> )
_bindrargs:
    ; off limits: rsp, r10, r8, r9, rax, rcx, rdx, rdi, r12-r15, xmm0-xmm4
    ; available: r11

    ds_underflow 1
    stack_popq r11, DATA_TOS_REG
    cmp r11, 4
    je .4args
    cmp r11, 3
    je .3args
    cmp r11, 2
    je .2args
    cmp r11, 1
    je .1arg
    jmp _next
    .4args:
    call bind_arg4
    .3args:
    call bind_arg3
    .2args:
    call bind_arg2
    .1arg:
    call bind_arg1

    jmp _next