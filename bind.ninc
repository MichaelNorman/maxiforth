; ********************************* calling & DLLs ******************************** ;

_lla:
    ds_underflow 1
    stack_popq rcx, DATA_TOS_REG ; lpLibFileName
    call LoadLibraryA
    stack_pushq rax, DATA_TOS_REG
    _NEXT

_gpa:
    ds_underflow 2
    stack_popq rdx, DATA_TOS_REG ; lpProcName
    stack_popq rcx, DATA_TOS_REG ; hModule
    call GetProcAddress
    stack_pushq rax, DATA_TOS_REG
    _NEXT

_do_call:
    ; put the address to call into r11
    mov r11, [IP_REG]
    stash_vm_state
    call r11 ; `bind` has done all the work of loading the registers. God help us all.
    add IP_REG, POINTER_SIZE ; step over the data cell
    _NEXT

; bind signature can be represented by: [vqdufF](;|[ifF]*)?
; A return code is mandatory; the optional |-suffix lists argument codes, one per
; argument, in call order.
; _______________________________________________________________________________________
; | Code | Meaning                                                     | Valid position |
; |------|-------------------------------------------------------------|----------------|
; |  v   | void. No return value. Push nothing.                        | return only    |
; |  q   | qword. Full 64 bits of rax. Pushed.                         | return only    |
; |  d   | dword. eax, sign-extended to a cell. Pushed.                | return only    |
; |  u   | dword. eax, zero-extended to a cell. Pushed.                | return only    |
; |  i   | integer or pointer, any width. Whole cell moved to          | argument only  |
; |      | parameter register; callee handles the upper bits.          |                |
; |  f   | 32-bit float. Returned in xmm0, passed in xmmN. Pushed.     | return/arg     |
; |  F   | 64-bit float. Returned in xmm0, passed in xmmN. Pushed.     | return/arg     |
; |______|_____________________________________________________________|________________|


; `bind` creates a word that marshals the arguments according to the signature string.
; Decisions that need to be made:
;   * Whether 'B' is present in the signature. If it is, then the register mapping is bumped by 1.
;   * The size of the shadow space. For every other argument past 4 (or 3?), more shadow space must be reserved in
;     16-byte chunks, I think...
;
; ( callee_addr sig_addr -- <name that follows `bind` on the input is a word that marshals according to sig_addr> )

; private words for binding the argument loaders.
cfa_arg1u:                  dq _arg1u
cfa_arg1i:                  dq _arg1i
cfa_arg1d:                  dq _arg1d
cfa_arg1f:                  dq _arg1f
cfa_arg1F:                  dq _arg1F
cfa_arg2u:                  dq _arg2u
cfa_arg2i:                  dq _arg2i
cfa_arg2d:                  dq _arg2d
cfa_arg2f:                  dq _arg2f
cfa_arg2F:                  dq _arg2F
cfa_arg3u:                  dq _arg3u
cfa_arg3i:                  dq _arg3i
cfa_arg3d:                  dq _arg3d
cfa_arg3f:                  dq _arg3f
cfa_arg3F:                  dq _arg3F
cfa_arg4u:                  dq _arg4u
cfa_arg4i:                  dq _arg4i
cfa_arg4d:                  dq _arg4d
cfa_arg4f:                  dq _arg4f
cfa_arg4F:                  dq _arg4F

_arg1u:
    stack_popq r10, DATA_TOS_REG ; value
    mov ecx, r10d
    _NEXT

_arg1i:
    stack_popq rcx, DATA_TOS_REG
    _NEXT

_arg1d:
    stack_popq r10, DATA_TOS_REG
    movsxd rcx, r10d
    _NEXT

_arg1f:
    stack_popq r11, DATA_TOS_REG
    movd xmm0, r11d
    _NEXT

_arg1F:
    stack_popq r10, DATA_TOS_REG
    movq xmm0, r10
    _NEXT

_arg2u:
    stack_popq r10, DATA_TOS_REG ; value
    mov edx, r10d
    _NEXT

_arg2i:
    stack_popq r10, DATA_TOS_REG
    mov rdx, r10
    _NEXT

_arg2d:
    stack_popq r10, DATA_TOS_REG
    movsxd rdx, r10d
    _NEXT

_arg2f:
    stack_popq r11, DATA_TOS_REG
    movd xmm1, r11d
    _NEXT

_arg2F:
    stack_popq r10, DATA_TOS_REG
    movq xmm1, r10
    _NEXT

_arg3u:
    stack_popq r10, DATA_TOS_REG ; value
    mov r8d, r10d
    _NEXT

_arg3i:
    stack_popq r10, DATA_TOS_REG
    mov r8, r10
    _NEXT

_arg3d:
    stack_popq r10, DATA_TOS_REG
    movsxd r8, r10d
    _NEXT

_arg3f:
    stack_popq r11, DATA_TOS_REG
    movd xmm2, r11d
    _NEXT

_arg3F:
    stack_popq r10, DATA_TOS_REG
    movq xmm2, r10
    _NEXT

_arg4u:
    stack_popq r10, DATA_TOS_REG ; value
    mov r9d, r10d
    _NEXT

_arg4i:
    stack_popq r10, DATA_TOS_REG
    mov r9, r10
    _NEXT

_arg4d:
    stack_popq r10, DATA_TOS_REG
    movsxd r9, r10d
    _NEXT

_arg4f:
    stack_popq r11, DATA_TOS_REG
    movd xmm3, r11d
    _NEXT

_arg4F:
    stack_popq r10, DATA_TOS_REG
    movq xmm3, r10
    _NEXT

bind_arg1:
    ; r10 contains the address of the type specifier
    mov rdi, [rel here]
    .check_i:
    cmp byte [r10], 'i'
    jne .check_d
    lea rax, [rel cfa_arg1i]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_d:
    cmp byte [r10], 'd'
    jne .check_u
    lea rax, [rel cfa_arg1d]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_u:
    cmp byte [r10], 'u'
    jne .check_f
    lea rax, [rel cfa_arg1u]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_f:
    cmp byte [r10], 'f'
    jne .do_F
    lea rax, [rel cfa_arg1f]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .do_F: ; no check. `bind` sets this up, so it's already checked.
    lea rax, [rel cfa_arg1F]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret

bind_arg2:
    ; r10b contains the type specifier
    mov rdi, [rel here]
    .check_i:
    cmp byte [r10], 'i'
    jne .check_d
    lea rax, [rel cfa_arg2i]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_d:
    cmp byte [r10], 'd'
    jne .check_u
    lea rax, [rel cfa_arg2d]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_u:
    cmp byte [r10], 'u'
    jne .check_f
    lea rax, [rel cfa_arg2u]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_f:
    cmp byte [r10], 'f'
    jne .do_F
    lea rax, [rel cfa_arg2f]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .do_F: ; no check. `bind` sets this up, so it's already checked.
    lea rax, [rel cfa_arg2F]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret

bind_arg3:
    ; r10b contains the type specifier
    mov rdi, [rel here]
    .check_i:
    cmp byte [r10], 'i'
    jne .check_d
    lea rax, [rel cfa_arg3i]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_d:
    cmp byte [r10], 'd'
    jne .check_u
    lea rax, [rel cfa_arg3d]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_u:
    cmp r10b, 'u'
    jne .check_f
    lea rax, [rel cfa_arg3u]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_f:
    cmp byte [r10], 'f'
    jne .do_F
    lea rax, [rel cfa_arg3f]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .do_F: ; no check. `bind` sets this up, so it's already checked.
    lea rax, [rel cfa_arg3F]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret

bind_arg4:
    ; r10b contains the type specifier
    mov rdi, [rel here]
    .check_i:
    cmp byte [r10], 'i'
    jne .check_d
    lea rax, [rel cfa_arg4i]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_d:
    cmp byte [r10], 'd'
    jne .check_u
    lea rax, [rel cfa_arg4d]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_u:
    cmp byte [r10], 'u'
    jne .check_f
    lea rax, [rel cfa_arg4u]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .check_f:
    cmp byte [r10], 'f'
    jne .do_F
    lea rax, [rel cfa_arg4f]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret
    .do_F: ; no check. `bind` sets this up, so it's already checked.
    lea rax, [rel cfa_arg4F]
    mov qword [rdi], rax
    add qword [rel here], POINTER_SIZE
    ret

_movrsp:
    ; get the current instruction pointer
    mov r8, [IP_REG]
    sub rsp, r8
    add IP_REG, POINTER_SIZE
    _NEXT

_rsp:
    ds_overflow 1
    stack_pushq rsp, DATA_TOS_REG
    _NEXT

; ( psigspec n -- <stack loading tokens placed in reverse order> )
_bindrargs:
    ; off limits: rsp, r10, r8, r9, rax, rcx, rdx, rdi, r12-r15, xmm0-xmm4
    ; available: r11

    ds_underflow 2
    stack_popq r11, DATA_TOS_REG
    stack_popq r10, DATA_TOS_REG
    add r10, 9
    add r10, r11

    cmp r11, 4
    je .4args
    cmp r11, 3
    je .3args
    cmp r11, 2
    je .2args
    cmp r11, 1
    je .1arg
    _NEXT
    .4args:
    call bind_arg4
    dec r10
    .3args:
    call bind_arg3
    dec r10
    .2args:
    call bind_arg2
    dec r10
    .1arg:
    call bind_arg1

    _NEXT

_bindret:
    ; stack has the return code on it, which can be any of the following values:
    ; |Value|Description|Register|
    ; |:----|:----------|:----------|
    ; |v|`void`. No return value. `rax` and `xmm0` contain garbage.|None|
    ; |B (arg list)|A "big struct" value. Anything with 3, 5, 6, 7, or more than 8 bytes, and nontrivial types. Pointer goes into `rcx` and shifts all args into the next register.|`rax` (pointer)|; |s|A struct with length 1, 2, 4, or 8 bytes.|`rax` (value)|
    ; |`[1248]`| A 1-, 2-, 4-, or 8-byte struct literal| `rax`|
    ; |f|A 32-bit floating-point value.|`xmm0`|
    ; |F|A 64-bit floating-point value.|`xmm0`|
    ; |q|A 64-bit integer.|`rax` (value)|
    ; |d|A 32-bit integer.|`eax` (value)|
    ; |u|A 32-bit unsigned integer.|`eax` (value)|
    ds_underflow 1
    mov rdi, [rel here]
    stack_popq r10, DATA_TOS_REG
    cmp r10b, 'v'
    je _next

    cmp r10b, 'B'
    jne .check_f
    lea r11, [rel cfa_B_ret]
    jmp .load_and_next

    .check_f:
    cmp r10b, 'f'
    jne .check_F
    lea r11, [rel cfa_f_ret]
    jmp .load_and_next
    .check_F:
    cmp r10b, 'F'
    jne .check_q
    lea r11, [rel cfa_F_ret]
    jmp .load_and_next
    .check_q:
    cmp r10b, 'q'
    jne .check_d
    lea r11, [rel cfa_q_ret]
    jmp .load_and_next
    .check_d:
    cmp r10b, 'd'
    jne .check_1
    lea r11, [rel cfa_d_ret]
    jmp .load_and_next
    .check_1:
    cmp r10b, '1'
    jne .check_2
    lea r11, [rel cfa_1_ret]
    jmp .load_and_next
    .check_2:
    cmp r10b, '2'
    jne .check_4
    lea r11, [rel cfa_2_ret]
    jmp .load_and_next
    .check_4:
    cmp r10b, '4'
    jne .check_8
    lea r11, [rel cfa_4_ret]
    jmp .load_and_next
    .check_8:
    cmp r10b, '8'
    jne .bind_u
    lea r11, [rel cfa_q_ret] ; It's the same operation
    jmp .load_and_next
    .bind_u: ; fail silently &/or default to the unsigned 32-bit handler. IOW, the dev must know what they're doing.
    lea r11, [rel cfa_u_ret]

    .load_and_next:
    mov [rdi], r11
    add qword [rel here], POINTER_SIZE
    _NEXT


cfa_B_ret: dq _do_B_ret
_do_B_ret:
    ds_overflow 1
    stack_pushq rax, DATA_TOS_REG
    _NEXT

cfa_f_ret: dq _do_f_ret
_do_f_ret:
    ds_overflow 1
    movd eax, xmm0
    stack_pushq rax, DATA_TOS_REG
    _NEXT

cfa_F_ret: dq _do_F_ret
_do_F_ret:
    ds_overflow 1
    movq rax, xmm0
    stack_pushq rax, DATA_TOS_REG
    _NEXT

cfa_q_ret: dq _do_q_ret
_do_q_ret:
    ds_overflow 1
    stack_pushq rax, DATA_TOS_REG
    _NEXT

cfa_d_ret: dq _do_d_ret
_do_d_ret:
    ds_overflow 1
    movsxd rax, eax
    stack_pushq rax, DATA_TOS_REG
    _NEXT

cfa_1_ret: dq _do_1_ret
_do_1_ret:
    ds_overflow 1
    movzx eax, al
    stack_pushq rax, DATA_TOS_REG
    _NEXT

cfa_2_ret: dq _do_2_ret
_do_2_ret:
    ds_overflow 1
    movzx eax, ax
    stack_pushq rax, DATA_TOS_REG
    _NEXT

cfa_4_ret: dq _do_4_ret
_do_4_ret:
    ds_overflow 1
    mov eax, eax
    stack_pushq rax, DATA_TOS_REG
    _NEXT

cfa_u_ret: dq _do_u_ret
_do_u_ret:
    ds_overflow 1
    mov eax, eax
    stack_pushq rax, DATA_TOS_REG
    _NEXT
