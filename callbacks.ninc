section .text
;*************************** callback handler *********************************;

; Needs a word in the static dictionary. For example, wndproc
; This address will be loaded into, for example, a WNDCLASSA structure to register WndProc
WndProc:
    mov rax, rsp
    lea r10, [rel wp_thread]
    jmp cb_handler

section .data
; Needs a word to expose this address in the static dictionary. For example, wp-thread
; The first slot will be filled with something like `' f-wndproc wp-thread !`
; `f-wndproc` in this example is the forth word that will handle the callback.
wp_thread:     dq 0, cfa_cb_ret
section .text

cb_handler:
; enter_call. It leaves rcx, rdx, r8, and r9 untouched.
; push_vm_state, push in_callback, then subtract 8 more bytes for the pad. rsp is 16-aligned again.
; Load DATA_TOS_REG from vm_state+8 and RETURN_TOS_REG from vm_state+0.
; Store 1 in in_callback.
; Point IP_REG at thread cell 0.
; _NEXT.

    enter_call ; push all nonvolatile registers
    push_vm_state ; push vm state
    push qword [rel in_callback]
    add rax, 8 ; move to address of first argument
    push rax ; Needs a word to latch this pushed value
    ; load DATA_TOS_REG and RETURN_TOS_REG
    mov DATA_TOS_REG, [rel vm_state +  POINTER_SIZE]
    mov RETURN_TOS_REG, [rel vm_state]
    ; note that we're in a callback
    mov qword [rel in_callback], 1
    ; set IP_REG and _NEXT
    mov IP_REG, r10
    _NEXT

; private word for callback return

cfa_cb_ret:                 dq _cb_ret

_cb_ret:
    push rcx
    push rdx
    ds_underflow 1
    pop rdx
    pop rcx
    stack_popq rax, DATA_TOS_REG
    add rsp, 8
    pop qword [rel in_callback]
    pop_vm_state
    leave_call
    ret

section .data

cb_thread:     dq 0, cfa_cb_ret
cb_testthread: dq 0, cfa_cb_ret

section .text

; words for pushing the addresses of WndProc and cb_thread

_wp_thunk_addr:
    ds_overflow 1
    lea r8, [rel wp_thunk]
    stack_pushq r8, DATA_TOS_REG
    _NEXT

wp_thunk:
    mov rax, rsp
    lea r10, [rel _wp_thunk_addr]
    jmp WndProc

_cb_thread:
    ds_overflow 1
    lea r8, [rel cb_thread]
    stack_pushq r8, DATA_TOS_REG
    _NEXT

_test_thunk_addr:
    ds_overflow 1
    lea r8, [rel test_thunk]
    stack_pushq r8, DATA_TOS_REG
    _NEXT

test_thunk:
    mov rax, rsp
    lea r10, [rel cb_testthread]
    jmp WndProc